# Build output -- everything here is regenerated by `make`; never commit it.

# Object files / compiled artifacts
*.o
*.pic.o
*.a
*.so

# Header dependency files emitted by $(DEPFLAGS) (-MMD -MP). One lands beside
# every object -- src/, libtoby/src/, programs/*/, third_party/**. They are
# pure build output, regenerated on every compile, and `make clean` removes
# them via $(ALL_DEPS).
*.d

# Clang writes these next to the output when a compile is interrupted.
*.o.tmp

# Linked program + kernel binaries
*.elf
*.bin
*.exe
tobyos.bin

# Track B (Linux compat): opt-in third-party Linux binaries fetched at test
# time -- never commit them (GPL busybox + musl loader; see
# programs/busybox/README.md for how to obtain them).
programs/busybox/busybox
programs/busybox/busybox-dyn
programs/busybox/ld-musl-x86_64.so.1
programs/busybox/libc.musl-x86_64.so.1
programs/busybox/file
programs/busybox/libmagic.so.1

# Track B/B26: opt-in glibc dynamic proof runtime objects (real glibc 2.41
# loader + shared libs fetched out-of-tree via programs/linux-glibc-dyn/build.sh).
programs/linux-glibc-dyn/lib/

# Track B/realtool: opt-in UNMODIFIED GNU binutils readelf + glibc runtime,
# lifted from the Bootlin toolchain via programs/realtool/build.sh (not committed).
programs/realtool/readelf
programs/realtool/lib64/

# Track B/realbash: opt-in UNMODIFIED GNU bash 5.2 (static), fetched out-of-tree
# via programs/realbash/build.sh (GPL; not committed).
programs/realbash/bash

# Track B/realtools: opt-in UNMODIFIED GNU Binutils battery + glibc runtime,
# lifted from the Bootlin toolchain via programs/realtools/build.sh (not committed).
programs/realtools/objdump
programs/realtools/nm
programs/realtools/size
programs/realtools/strings
programs/realtools/cppfilt
programs/realtools/lib64/

# Track B/realpython: opt-in UNMODIFIED static-stdlib CPython 3.10 (dynamic musl)
# fetched out-of-tree via programs/realpython/build.sh (not committed). The
# build.sh and the tiny hello.py proof script ARE committed.
programs/realpython/python3
programs/realpython/python310.zip
programs/realpython/*.tar.gz
programs/realpython/extract/

# Track B/realcc: opt-in UNMODIFIED TinyCC 0.9.27 (dynamic musl) fetched
# out-of-tree via programs/realcc/build.sh (not committed). build.sh and the
# tiny hello_cc.c proof source ARE committed.
programs/realcc/tcc
programs/realcc/libtcc.so
programs/realcc/tcclib/
programs/realcc/*.apk
programs/realcc/extract/

# Track C/realtui: opt-in UNMODIFIED GNU nano + libncursesw + terminfo (Alpine,
# dynamic musl) fetched out-of-tree via programs/realtui/build.sh (not
# committed). build.sh IS committed (resolves versions live from APKINDEX).
programs/realtui/nano
programs/realtui/libncursesw.so.6
programs/realtui/terminfo/
programs/realtui/*.apk
programs/realtui/extract/

# Track C/realcurl: opt-in UNMODIFIED static curl (stunnel/static-curl, musl)
# fetched out-of-tree via programs/realcurl/build.sh (not committed). build.sh
# IS committed (pins version + sha256).
programs/realcurl/curl
programs/realcurl/*.tar.xz

# Bootable images / filesystems produced by the build
#
# NOTE: gitignore has NO trailing-comment syntax -- everything after the pattern
# is part of the pattern. `nvme*.img  # scratch...` therefore matched nothing,
# which is why nvme4k.img / nvme512.img / sata.img showed up as untracked for
# months while disk.img (no comment) was correctly ignored. Comments go on their
# own line.
*.iso
disk.img
disk.img.*
# scratch NVMe backing images for QEMU storage tests
nvme*.img
# scratch AHCI/SATA backing images for QEMU storage tests
sata*.img
*.tar
build/
iso/

# Disassembly / map dumps
*.dasm
*.map

# Build scratch
.tmpbuild/

# QEMU + capture logs (also covered by the root .gitignore)
qemu*.log
logs/

# Frame-grab scratch from real-HW video debugging
logs/frames*/
programs/chromium/chrome-linux64/
programs/chromium/chrome-linux64.zip

# Third-party payloads that are FETCHED, not committed (programs/*/fetch.sh).
# The Alpine minirootfs backs slice 7 (LXALPINE_BOOT) and slice 16's container
# capstone (LXCONTAINER_BOOT); get it with: bash programs/alpine/fetch.sh
programs/alpine/*.tar.gz

# Opt-in acceptance binaries built by their own build.sh, like the sibling
# linux-* tests above them.
programs/linux-clonestk/*.elf
programs/linux-ocirun/*.elf
programs/linux-ctrprobe/*.elf
programs/linux-gapfill/*.elf
programs/linux-cloexec/*.elf
programs/linux-flock/*.elf
programs/linux-sock/*.elf
programs/linux-sockserver/*.elf
programs/linux-nptl/*.elf
programs/linux-watch/*.elf
programs/linux-tmpfs/*.elf
programs/linux-ptrace/*.elf

# Build scratch left by ad-hoc debugging sessions
.tmp_*/
.tmp_*.sh
