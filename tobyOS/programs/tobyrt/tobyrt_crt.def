; tobyrt.dll's imports of the kernel's C runtime half (W7k): the checked
; functions, whose invalid-parameter path tobyrt.dll finishes by calling the
; program's handler, and abort. An import library dlltool makes of it.
LIBRARY api-ms-win-crt-runtime-l1-1-0.dll
EXPORTS
    __toby_strcpy_s
    __toby_strcat_s
    __toby_stdio_common_vsprintf_s
    __toby_abort
    __toby__setmode
    __toby__set_fmode
    __toby__get_fmode
    __toby__open
    __toby__close
    __toby__read
    __toby__write
    __toby__lseek
    __toby__lseeki64
    __toby__eof
    __toby_stdio_common_vfprintf
    __toby_stdio_common_vfscanf
    __toby_fputs
    __toby_puts
    __toby_fputc
    __toby_putchar
    __toby_fgetc
    __toby_getchar
    __toby_fgets
    __toby_ungetc
    __toby_fopen
    __toby__wfopen
    __toby__fsopen
    __toby__wfsopen
    __toby_freopen
    __toby_setvbuf
