; tobyrt.dll's imports of the kernel's user32 half (W7j): the window and
; timer state DispatchMessage, SendMessage and CreateWindowEx ask about, and
; the kernel's CreateWindowEx and SendMessage (for a control's, a dialog's).
; The Makefile makes an import library of it with dlltool.
LIBRARY user32.dll
EXPORTS
    __toby_msgsvc
    __toby_CreateWindowExA
    __toby_SendMessageA
    __toby_GetMessageA
    __toby_PeekMessageA
    __toby_WaitMessage
    __toby_CreateWindowExW
    __toby_GetWindowTextA
    __toby_GetWindowTextW
    __toby_GetWindowTextLengthA
    __toby_GetWindowTextLengthW
    __toby_SetWindowTextA
    __toby_SetWindowTextW
    __toby_SleepEx
    __toby_WaitForSingleObjectEx
    __toby_WaitForMultipleObjectsEx
    __toby_MsgWaitForMultipleObjectsEx
    __toby_dlgsvc
    __toby_MessageBoxA
    __toby_MessageBoxW
    __toby_DestroyWindow
