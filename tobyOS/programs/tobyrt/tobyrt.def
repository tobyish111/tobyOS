; tobyrt.dll -- the tobyOS Win32 runtime (W7b). The loader (src/pe_loader.c,
; g_pe_rt_names) binds a program's import of each of these names from a
; built-in DLL (kernel32, ntdll, the CRT's) to this DLL's export.
LIBRARY tobyrt.dll
EXPORTS
    RaiseException = rt_RaiseException
    RtlRaiseException = rt_RtlRaiseException
    RtlCaptureContext = rt_capture_context
    RtlRestoreContext = rt_RtlRestoreContext
    RtlLookupFunctionEntry = rt_RtlLookupFunctionEntry
    RtlVirtualUnwind = rt_RtlVirtualUnwind
    RtlUnwindEx = rt_RtlUnwindEx
    RtlUnwind = rt_RtlUnwind
    __C_specific_handler = rt_C_specific_handler
    SetUnhandledExceptionFilter = rt_SetUnhandledExceptionFilter
    UnhandledExceptionFilter = rt_UnhandledExceptionFilter
    SetErrorMode = rt_SetErrorMode
    GetErrorMode = rt_GetErrorMode
    AddVectoredExceptionHandler = rt_AddVectoredExceptionHandler
    RemoveVectoredExceptionHandler = rt_RemoveVectoredExceptionHandler
    AddVectoredContinueHandler = rt_AddVectoredContinueHandler
    RemoveVectoredContinueHandler = rt_RemoveVectoredContinueHandler
    RtlAddVectoredExceptionHandler = rt_AddVectoredExceptionHandler
    RtlRemoveVectoredExceptionHandler = rt_RemoveVectoredExceptionHandler
    RtlAddVectoredContinueHandler = rt_AddVectoredContinueHandler
    RtlRemoveVectoredContinueHandler = rt_RemoveVectoredContinueHandler
    KiUserExceptionDispatcher = rt_KiUserExceptionDispatcher
    GetCurrentThreadStackLimits = rt_GetCurrentThreadStackLimits
    RtlAddFunctionTable = rt_RtlAddFunctionTable
    RtlDeleteFunctionTable = rt_RtlDeleteFunctionTable
    RtlInstallFunctionTableCallback = rt_RtlInstallFunctionTableCallback
    RtlAddGrowableFunctionTable = rt_RtlAddGrowableFunctionTable
    RtlGrowFunctionTable = rt_RtlGrowFunctionTable
    RtlDeleteGrowableFunctionTable = rt_RtlDeleteGrowableFunctionTable
    __intrinsic_setjmp = rt_setjmp
    __intrinsic_setjmpex = rt_setjmp
    _setjmp = rt_setjmp
    _setjmpex = rt_setjmp
    setjmp = rt_setjmp
    longjmp = rt_longjmp
    __toby_ldr_handler = rt_ldr_handler
    RtlPcToFileHeader = rt_RtlPcToFileHeader
    _initterm = rt_initterm
    _initterm_e = rt_initterm_e
    DispatchMessageA = rt_DispatchMessageA
    DispatchMessageW = rt_DispatchMessageA
    SendMessageA = rt_SendMessageA
    CreateWindowExA = rt_CreateWindowExA
    strcpy_s = rt_strcpy_s
    strcat_s = rt_strcat_s
    __stdio_common_vsprintf_s = rt_stdio_common_vsprintf_s
    set_terminate = rt_set_terminate
    _get_terminate = rt_get_terminate
    terminate = rt_crt_terminate
    exit = rt_exit
    InitOnceExecuteOnce = rt_InitOnceExecuteOnce
    _setmode = rt__setmode
    _set_fmode = rt__set_fmode
    _get_fmode = rt__get_fmode
    _open = rt__open
    _close = rt__close
    _read = rt__read
    _write = rt__write
    _lseek = rt__lseek
    _lseeki64 = rt__lseeki64
    _eof = rt__eof
