#include <windows.h>

#define IDD_MAIN   101
#define IDC_EDIT   1001
#define IDC_CHECK  1002
#define IDC_RAD_A  1003
#define IDC_RAD_B  1004

IDD_MAIN DIALOGEX 0, 0, 220, 150
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "tobyOS C14 Dialog"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Name:", -1, 12, 12, 40, 10
    EDITTEXT        IDC_EDIT, 55, 10, 150, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Subscribe", IDC_CHECK, 12, 36, 90, 12
    GROUPBOX        "Plan", -1, 12, 54, 196, 40
    AUTORADIOBUTTON "Free",    IDC_RAD_A, 24, 68, 60, 12, WS_GROUP
    AUTORADIOBUTTON "Premium", IDC_RAD_B, 110, 68, 70, 12
    DEFPUSHBUTTON   "OK", IDOK, 55, 118, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 115, 118, 50, 16
END
