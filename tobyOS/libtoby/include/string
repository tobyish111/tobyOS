/* <string> -- freestanding std::string for tobyOS C++ (STL slice 3).
 * Heap-backed basic_string<char> (no SSO), plus std::to_string. Enough of
 * the interface for the STL and libgav1 (mostly logging/version there). */
#ifndef _LIBTOBY_STRING
#define _LIBTOBY_STRING

#include <cstddef>
#include <cstring>
#include <cstdio>
#include <new>
#include <initializer_list>
#include <utility>

namespace std {

template <class _CharT>
class basic_string {
public:
    typedef _CharT     value_type;
    typedef size_t     size_type;
    typedef _CharT*       iterator;
    typedef const _CharT* const_iterator;
    typedef _CharT&       reference;
    typedef const _CharT& const_reference;
    static const size_t npos = (size_t)-1;

    basic_string() { __init(nullptr, 0); }
    basic_string(const _CharT* __s) { __init(__s, __len(__s)); }
    basic_string(const _CharT* __s, size_t __n) { __init(__s, __n); }
    basic_string(size_t __n, _CharT __c) {
        __alloc_cap(__n);
        for (size_t __i = 0; __i < __n; ++__i) __d_[__i] = __c;
        __size_ = __n; __d_[__n] = 0;
    }
    basic_string(const basic_string& __o) { __init(__o.__d_, __o.__size_); }
    basic_string(basic_string&& __o) noexcept
        : __d_(__o.__d_), __size_(__o.__size_), __cap_(__o.__cap_) {
        __o.__d_ = nullptr; __o.__size_ = 0; __o.__cap_ = 0;
    }
    ~basic_string() { ::operator delete(__d_); }

    basic_string& operator=(const basic_string& __o) {
        if (this != &__o) assign(__o.__d_, __o.__size_); return *this;
    }
    basic_string& operator=(basic_string&& __o) noexcept {
        if (this != &__o) { ::operator delete(__d_);
            __d_ = __o.__d_; __size_ = __o.__size_; __cap_ = __o.__cap_;
            __o.__d_ = nullptr; __o.__size_ = 0; __o.__cap_ = 0; }
        return *this;
    }
    basic_string& operator=(const _CharT* __s) { assign(__s, __len(__s)); return *this; }

    void assign(const _CharT* __s, size_t __n) {
        if (__n > __cap_) __grow_to(__n);
        for (size_t __i = 0; __i < __n; ++__i) __d_[__i] = __s[__i];
        __size_ = __n; __d_[__n] = 0;
    }

    size_t size() const noexcept { return __size_; }
    size_t length() const noexcept { return __size_; }
    size_t capacity() const noexcept { return __cap_; }
    bool empty() const noexcept { return __size_ == 0; }
    void clear() noexcept { __size_ = 0; if (__d_) __d_[0] = 0; }
    void reserve(size_t __n) { if (__n > __cap_) __grow_to(__n); }
    void resize(size_t __n, _CharT __c = _CharT()) {
        if (__n > __cap_) __grow_to(__n);
        for (size_t __i = __size_; __i < __n; ++__i) __d_[__i] = __c;
        __size_ = __n; __d_[__n] = 0;
    }

    reference operator[](size_t __i) { return __d_[__i]; }
    const_reference operator[](size_t __i) const { return __d_[__i]; }
    reference at(size_t __i) { return __d_[__i]; }
    const_reference at(size_t __i) const { return __d_[__i]; }
    reference front() { return __d_[0]; }
    reference back() { return __d_[__size_ - 1]; }
    const _CharT* c_str() const noexcept { return __d_ ? __d_ : __empty(); }
    const _CharT* data() const noexcept { return c_str(); }
    _CharT* data() noexcept { return __d_; }

    iterator begin() noexcept { return __d_; }
    const_iterator begin() const noexcept { return __d_; }
    iterator end() noexcept { return __d_ + __size_; }
    const_iterator end() const noexcept { return __d_ + __size_; }

    void push_back(_CharT __c) {
        if (__size_ + 1 > __cap_) __grow_to(__size_ ? __size_ * 2 : 8);
        __d_[__size_++] = __c; __d_[__size_] = 0;
    }
    basic_string& append(const _CharT* __s, size_t __n) {
        if (__size_ + __n > __cap_) __grow_to((__size_ + __n) * 2);
        for (size_t __i = 0; __i < __n; ++__i) __d_[__size_ + __i] = __s[__i];
        __size_ += __n; __d_[__size_] = 0; return *this;
    }
    basic_string& append(const _CharT* __s) { return append(__s, __len(__s)); }
    basic_string& append(const basic_string& __o) { return append(__o.__d_, __o.__size_); }
    basic_string& append(size_t __n, _CharT __c) {
        if (__size_ + __n > __cap_) __grow_to((__size_ + __n) * 2);
        for (size_t __i = 0; __i < __n; ++__i) __d_[__size_ + __i] = __c;
        __size_ += __n; __d_[__size_] = 0; return *this;
    }
    basic_string& operator+=(const basic_string& __o) { return append(__o); }
    basic_string& operator+=(const _CharT* __s) { return append(__s); }
    basic_string& operator+=(_CharT __c) { push_back(__c); return *this; }

    basic_string substr(size_t __pos = 0, size_t __n = npos) const {
        size_t __avail = __pos <= __size_ ? __size_ - __pos : 0;
        size_t __cnt = __n < __avail ? __n : __avail;
        return basic_string(__d_ + __pos, __cnt);
    }
    size_t find(_CharT __c, size_t __pos = 0) const {
        for (size_t __i = __pos; __i < __size_; ++__i) if (__d_[__i] == __c) return __i;
        return npos;
    }
    size_t find(const _CharT* __s, size_t __pos = 0) const {
        size_t __n = __len(__s);
        if (__n == 0) return __pos <= __size_ ? __pos : npos;
        for (size_t __i = __pos; __i + __n <= __size_; ++__i) {
            size_t __j = 0; while (__j < __n && __d_[__i + __j] == __s[__j]) ++__j;
            if (__j == __n) return __i;
        }
        return npos;
    }

    int compare(const basic_string& __o) const {
        size_t __n = __size_ < __o.__size_ ? __size_ : __o.__size_;
        for (size_t __i = 0; __i < __n; ++__i)
            if (__d_[__i] != __o.__d_[__i])
                return (unsigned char)__d_[__i] < (unsigned char)__o.__d_[__i] ? -1 : 1;
        return __size_ == __o.__size_ ? 0 : (__size_ < __o.__size_ ? -1 : 1);
    }

private:
    _CharT* __d_ = nullptr;
    size_t  __size_ = 0;
    size_t  __cap_ = 0;

    static const _CharT* __empty() { static const _CharT __e = 0; return &__e; }
    static size_t __len(const _CharT* __s) {
        size_t __n = 0; if (__s) while (__s[__n]) ++__n; return __n;
    }
    void __alloc_cap(size_t __n) {
        __cap_ = __n; __d_ = static_cast<_CharT*>(::operator new((__n + 1) * sizeof(_CharT)));
    }
    void __init(const _CharT* __s, size_t __n) {
        __alloc_cap(__n);
        for (size_t __i = 0; __i < __n; ++__i) __d_[__i] = __s[__i];
        __size_ = __n; __d_[__n] = 0;
    }
    void __grow_to(size_t __n) {
        _CharT* __nd = static_cast<_CharT*>(::operator new((__n + 1) * sizeof(_CharT)));
        for (size_t __i = 0; __i < __size_; ++__i) __nd[__i] = __d_[__i];
        __nd[__size_] = 0; ::operator delete(__d_); __d_ = __nd; __cap_ = __n;
    }
};

typedef basic_string<char> string;

template <class _C>
inline basic_string<_C> operator+(const basic_string<_C>& __a, const basic_string<_C>& __b) {
    basic_string<_C> __r(__a); __r.append(__b); return __r;
}
template <class _C>
inline basic_string<_C> operator+(const basic_string<_C>& __a, const _C* __b) {
    basic_string<_C> __r(__a); __r.append(__b); return __r;
}
template <class _C>
inline basic_string<_C> operator+(const _C* __a, const basic_string<_C>& __b) {
    basic_string<_C> __r(__a); __r.append(__b); return __r;
}
template <class _C>
inline basic_string<_C> operator+(const basic_string<_C>& __a, _C __b) {
    basic_string<_C> __r(__a); __r.push_back(__b); return __r;
}
template <class _C>
inline bool operator==(const basic_string<_C>& __a, const basic_string<_C>& __b) {
    return __a.compare(__b) == 0;
}
template <class _C>
inline bool operator==(const basic_string<_C>& __a, const _C* __b) {
    return __a.compare(basic_string<_C>(__b)) == 0;
}
template <class _C>
inline bool operator!=(const basic_string<_C>& __a, const basic_string<_C>& __b) {
    return __a.compare(__b) != 0;
}
template <class _C>
inline bool operator<(const basic_string<_C>& __a, const basic_string<_C>& __b) {
    return __a.compare(__b) < 0;
}

inline string to_string(long long __v) { char __b[32]; snprintf(__b, sizeof __b, "%lld", __v); return string(__b); }
inline string to_string(long __v) { char __b[32]; snprintf(__b, sizeof __b, "%ld", __v); return string(__b); }
inline string to_string(int __v) { char __b[16]; snprintf(__b, sizeof __b, "%d", __v); return string(__b); }
inline string to_string(unsigned __v) { char __b[16]; snprintf(__b, sizeof __b, "%u", __v); return string(__b); }
inline string to_string(unsigned long __v) { char __b[32]; snprintf(__b, sizeof __b, "%lu", __v); return string(__b); }
inline string to_string(unsigned long long __v) { char __b[32]; snprintf(__b, sizeof __b, "%llu", __v); return string(__b); }
inline string to_string(double __v) { char __b[32]; snprintf(__b, sizeof __b, "%f", __v); return string(__b); }

}  // namespace std

#endif /* _LIBTOBY_STRING */
