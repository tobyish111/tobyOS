/* <memory> -- freestanding subset for tobyOS C++ (STL slice 2):
 * unique_ptr (single + array) + make_unique, default_delete, addressof,
 * allocator + a minimal allocator_traits for the containers. */
#ifndef _LIBTOBY_MEMORY
#define _LIBTOBY_MEMORY

#include <cstddef>
#include <type_traits>
#include <utility>
#include <new>

namespace std {

/* ---- addressof ---- */
template <class _T> constexpr _T* addressof(_T& __r) noexcept {
    return __builtin_addressof(__r);
}

/* ---- default_delete ---- */
template <class _T> struct default_delete {
    constexpr default_delete() noexcept = default;
    template <class _U> default_delete(const default_delete<_U>&) noexcept {}
    void operator()(_T* __p) const { delete __p; }
};
template <class _T> struct default_delete<_T[]> {
    constexpr default_delete() noexcept = default;
    void operator()(_T* __p) const { delete[] __p; }
    template <class _U> void operator()(_U*) const = delete;
};

/* ---- unique_ptr (single object) ---- */
template <class _T, class _D = default_delete<_T> >
class unique_ptr {
public:
    typedef _T  element_type;
    typedef _T* pointer;
    typedef _D  deleter_type;

    constexpr unique_ptr() noexcept : __p_(nullptr), __d_() {}
    constexpr unique_ptr(decltype(nullptr)) noexcept : __p_(nullptr), __d_() {}
    explicit unique_ptr(pointer __p) noexcept : __p_(__p), __d_() {}
    unique_ptr(pointer __p, _D __d) noexcept : __p_(__p), __d_(static_cast<_D&&>(__d)) {}

    unique_ptr(unique_ptr&& __o) noexcept : __p_(__o.release()), __d_(static_cast<_D&&>(__o.__d_)) {}
    template <class _U, class _E>
    unique_ptr(unique_ptr<_U, _E>&& __o) noexcept : __p_(__o.release()), __d_() {}

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    unique_ptr& operator=(unique_ptr&& __o) noexcept {
        if (this != &__o) { reset(__o.release()); __d_ = static_cast<_D&&>(__o.__d_); }
        return *this;
    }
    unique_ptr& operator=(decltype(nullptr)) noexcept { reset(); return *this; }

    ~unique_ptr() { if (__p_) __d_(__p_); }

    _T& operator*() const { return *__p_; }
    pointer operator->() const noexcept { return __p_; }
    pointer get() const noexcept { return __p_; }
    _D& get_deleter() noexcept { return __d_; }
    const _D& get_deleter() const noexcept { return __d_; }
    explicit operator bool() const noexcept { return __p_ != nullptr; }

    pointer release() noexcept { pointer __t = __p_; __p_ = nullptr; return __t; }
    void reset(pointer __p = nullptr) noexcept {
        pointer __old = __p_; __p_ = __p; if (__old) __d_(__old);
    }
    void swap(unique_ptr& __o) noexcept { std::swap(__p_, __o.__p_); std::swap(__d_, __o.__d_); }

private:
    pointer __p_;
    _D      __d_;
    template <class, class> friend class unique_ptr;
};

/* ---- unique_ptr (array) ---- */
template <class _T, class _D>
class unique_ptr<_T[], _D> {
public:
    typedef _T  element_type;
    typedef _T* pointer;
    typedef _D  deleter_type;

    constexpr unique_ptr() noexcept : __p_(nullptr), __d_() {}
    constexpr unique_ptr(decltype(nullptr)) noexcept : __p_(nullptr), __d_() {}
    explicit unique_ptr(pointer __p) noexcept : __p_(__p), __d_() {}
    unique_ptr(unique_ptr&& __o) noexcept : __p_(__o.release()), __d_(static_cast<_D&&>(__o.__d_)) {}
    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;
    unique_ptr& operator=(unique_ptr&& __o) noexcept {
        if (this != &__o) { reset(__o.release()); __d_ = static_cast<_D&&>(__o.__d_); }
        return *this;
    }
    ~unique_ptr() { if (__p_) __d_(__p_); }

    _T& operator[](size_t __i) const { return __p_[__i]; }
    pointer get() const noexcept { return __p_; }
    explicit operator bool() const noexcept { return __p_ != nullptr; }
    pointer release() noexcept { pointer __t = __p_; __p_ = nullptr; return __t; }
    void reset(pointer __p = nullptr) noexcept {
        pointer __old = __p_; __p_ = __p; if (__old) __d_(__old);
    }
    void swap(unique_ptr& __o) noexcept { std::swap(__p_, __o.__p_); std::swap(__d_, __o.__d_); }
private:
    pointer __p_;
    _D      __d_;
};

template <class _T, class _D>
void swap(unique_ptr<_T, _D>& __a, unique_ptr<_T, _D>& __b) noexcept { __a.swap(__b); }
template <class _T, class _D>
bool operator==(const unique_ptr<_T, _D>& __a, decltype(nullptr)) noexcept { return !__a; }
template <class _T, class _D>
bool operator!=(const unique_ptr<_T, _D>& __a, decltype(nullptr)) noexcept { return (bool)__a; }
template <class _T, class _D1, class _U, class _D2>
bool operator==(const unique_ptr<_T, _D1>& __a, const unique_ptr<_U, _D2>& __b) {
    return __a.get() == __b.get();
}
template <class _T, class _D1, class _U, class _D2>
bool operator!=(const unique_ptr<_T, _D1>& __a, const unique_ptr<_U, _D2>& __b) {
    return __a.get() != __b.get();
}

/* ---- make_unique ---- */
template <class _T> struct __unique_if { typedef unique_ptr<_T> __single; };
template <class _T> struct __unique_if<_T[]> { typedef unique_ptr<_T[]> __array; };
template <class _T, size_t _N> struct __unique_if<_T[_N]> { struct __known {}; };

template <class _T, class... _A>
typename __unique_if<_T>::__single make_unique(_A&&... __a) {
    return unique_ptr<_T>(new _T(static_cast<_A&&>(__a)...));
}
template <class _T>
typename __unique_if<_T>::__array make_unique(size_t __n) {
    typedef typename remove_extent<_T>::type _E;
    return unique_ptr<_T>(new _E[__n]());
}

/* ---- allocator + minimal allocator_traits ---- */
template <class _T> struct allocator {
    typedef _T        value_type;
    typedef _T*       pointer;
    typedef const _T* const_pointer;
    typedef _T&       reference;
    typedef const _T& const_reference;
    typedef size_t    size_type;
    typedef ptrdiff_t difference_type;
    template <class _U> struct rebind { typedef allocator<_U> other; };

    constexpr allocator() noexcept = default;
    template <class _U> constexpr allocator(const allocator<_U>&) noexcept {}

    _T* allocate(size_t __n) {
        return static_cast<_T*>(::operator new(__n * sizeof(_T)));
    }
    void deallocate(_T* __p, size_t) noexcept { ::operator delete(__p); }
    template <class _U, class... _A> void construct(_U* __p, _A&&... __a) {
        ::new ((void*)__p) _U(static_cast<_A&&>(__a)...);
    }
    template <class _U> void destroy(_U* __p) { __p->~_U(); }
    size_t max_size() const noexcept { return ~size_t(0) / sizeof(_T); }
};
template <class _T, class _U>
constexpr bool operator==(const allocator<_T>&, const allocator<_U>&) noexcept { return true; }
template <class _T, class _U>
constexpr bool operator!=(const allocator<_T>&, const allocator<_U>&) noexcept { return false; }

template <class _A> struct allocator_traits {
    typedef _A allocator_type;
    typedef typename _A::value_type value_type;
    typedef value_type* pointer;
    typedef const value_type* const_pointer;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    template <class _U> struct rebind_alloc { typedef allocator<_U> other; };

    static pointer allocate(_A& __a, size_t __n) { return __a.allocate(__n); }
    static void deallocate(_A& __a, pointer __p, size_t __n) noexcept { __a.deallocate(__p, __n); }
    template <class _T, class... _Args>
    static void construct(_A& __a, _T* __p, _Args&&... __args) {
        __a.construct(__p, static_cast<_Args&&>(__args)...);
    }
    template <class _T> static void destroy(_A& __a, _T* __p) { __a.destroy(__p); }
    static size_type max_size(const _A& __a) noexcept { return __a.max_size(); }
};

}  // namespace std

#endif /* _LIBTOBY_MEMORY */
